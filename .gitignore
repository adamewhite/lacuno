# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated word lists — rebuild with `npm run build:wordlists`
/data/generated

# local tooling config
.claude/

# upstream 12dicts package — the files we use are vendored in data/raw/
# (2of12inf.txt and the ReadMe, which the licence asks us to ship)
/12dicts-6.0.2
